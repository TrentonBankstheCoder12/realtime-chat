{
  "name": "realtime-chat",
  "version": "1.0.0",
  "description": "Realtime chat server on raw WebSockets (ws): rooms, presence, typing, history, zod-validated protocol, token-bucket rate limiting, heartbeats",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.test.json"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
